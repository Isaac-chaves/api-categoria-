# Variables de entorno de referencia.
# Este archivo NO se carga automaticamente: en local se usan los valores
# predeterminados de configuracion/datos_conexion.php y en Render se
# configuran en el panel del servicio (Environment).

# Conexion individual
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ventas
DB_USER=root
DB_PASSWORD=

# Alternativa: una sola URL (tiene prioridad si las variables anteriores
# no estan definidas).
# DATABASE_URL=mysql://usuario:clave@servidor:3306/ventas

# TLS opcional (Aiven, TiDB y otros proveedores lo exigen).
# Puede ser una ruta o el contenido PEM completo del certificado.
# DB_SSL_CA=
# DB_SSL_VERIFICAR=false

# Crea las tablas y los datos iniciales al arrancar el contenedor.
AUTO_INIT_DB=true
