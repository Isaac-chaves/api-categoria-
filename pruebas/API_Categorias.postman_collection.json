{
  "info": {
    "name": "API Categorias - Pruebas",
    "description": "Colección de pruebas de la API de categorías. Cambie la variable baseUrl por http://localhost:18080 (Docker) o por https://TU-SERVICIO.onrender.com (Render). Ejecute toda la colección con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "cedula",
      "value": "1"
    },
    {
      "key": "clave",
      "value": "01"
    }
  ],
  "item": [
    {
      "name": "00 - Limpiar categoría de prueba",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Cedula",
            "value": "{{cedula}}"
          },
          {
            "key": "X-Contrasena",
            "value": "{{clave}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"codigo\":5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/controlador/categoria.php",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "controlador",
            "categoria.php"
          ]
        }
      }
