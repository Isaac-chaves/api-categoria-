    {
      "name": "01 - Información de la API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Código 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"La API está en línea\", function () {",
              "    pm.expect(pm.response.json().estado).to.eql(\"en linea\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
