          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Código 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Devuelve un arreglo con al menos 4 categorías\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an(\"array\");",
              "    pm.expect(body.length).to.be.at.least(4);",
              "});",
              "pm.test(\"Cada categoría tiene codigo y nombre\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body[0]).to.have.property(\"codigo\");",
              "    pm.expect(body[0]).to.have.property(\"nombre\");",
